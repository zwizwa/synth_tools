name: synth-tools
version: 1.0.0
build-type: Simple
license: BSD3
cabal-version: >= 1.10

-- This is for the DSL and support code.

executable synth-tools
    build-depends: base, Stream, data-reify, containers, data-fix, mtl, lens,
                   process, binary, bytestring
    main-is: synth-tools.hs
    default-language: Haskell2010
    ghc-options: -fprint-potential-instances
    other-modules: SynthTools.DSL
                   SynthTools.Eval
                   SynthTools.Comp
                   SynthTools.ToC
                   SynthTools.RunC
                   SynthTools.ToV

